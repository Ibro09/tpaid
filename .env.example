# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Twitch Helix channel suggestions (server-only; never expose these with VITE_).
TWITCH_CLIENT_ID="YOUR_TWITCH_CLIENT_ID"
TWITCH_CLIENT_SECRET="YOUR_TWITCH_CLIENT_SECRET"
# Optional when you already have an app access token; otherwise the server obtains one.
TWITCH_APP_ACCESS_TOKEN="YOUR_TWITCH_APP_ACCESS_TOKEN"
RAPIDAPI_KEY="YOUR_RAPIDAPI_KEY"
REEF_KEY="YOUR_REEF_API_KEY"

# MongoDB persistence for Explore tokens and live market updates.
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="tipped"

# Enable the Google Sheets API, then share this spreadsheet with the service-account email as an editor.
GOOGLE_SHEETS_SPREADSHEET_ID="YOUR_SHARED_GOOGLE_SHEET_ID"
GOOGLE_SERVICE_ACCOUNT_EMAIL="YOUR_SERVICE_ACCOUNT_EMAIL"
# Keep this server-only; store the PEM private key with literal \n line breaks.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Pons V2 direct factory launch configuration.
VITE_PONS_V2_PAIR_TOKEN="0xYOUR_ROBINHOOD_PAIR_TOKEN"
VITE_PONS_V2_CONFIG_ID="0"
VITE_PONS_V2_LAUNCH_BUY_ROUTER="0xe33E9E479dF8802cb0866d5d05258bEc4cF62948"
VITE_PONS_V2_CREATOR_TAX_BPS="0"
VITE_PONS_V2_DEPLOYMENT_BLOCK="26841846"
